<?xml version="1.0"?>
<package format="3">
  <name>bringup</name>
  <version>0.1.0</version>
  <description>System ROS 2 launch files for the farm simulator viewers and nodes.</description>
  <maintainer email="stuart.g.johnson@gmail.com">Stuart G Johnson</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>ground_truth_localization</exec_depend>
  <exec_depend>mapviz</exec_depend>
  <exec_depend>tile_map</exec_depend>
  <exec_depend>mapviz_plugins</exec_depend>
  <exec_depend>swri_transform_util</exec_depend>
  <exec_depend>python3-pyproj</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-launch</exec_depend>
  <exec_depend>python3-launch-ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
